{
  "name": "zavarov-com",
  "private": true,
  "description": "Dev-only source for static/likely/ assets. Hugo does not use npm at build time.",
  "scripts": {
    "translate": "node scripts/translate.mjs",
    "translate:force": "node scripts/translate.mjs --force",
    "fetch-telegram-reactions": "node themes/hugo-mini/scripts/fetch-telegram-reactions.mjs",
    "update-likely": "npm install && cp node_modules/ilyabirman-likely/release/likely.js node_modules/ilyabirman-likely/release/likely.css static/likely/"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "ilyabirman-likely": "^3.2.0"
  }
}
