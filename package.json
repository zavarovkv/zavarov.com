{
  "name": "zavarov-com",
  "private": true,
  "description": "Build-time scripts for the zavarov.com Hugo site (RU→EN translation, Telegram reactions fetch).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run fetch-github-stars && hugo server --bind 127.0.0.1",
    "build": "npm run fetch-github-stars && hugo --minify --panicOnWarning",
    "test": "node --test tests/*.test.mjs events/tests/*.test.mjs themes/hugo-mini/tests/*.test.mjs",
    "test:theme": "node --test themes/hugo-mini/tests/*.test.mjs",
    "test:events": "node --test events/tests/*.test.mjs",
    "postinstall": "node scripts/vendor-mermaid.mjs",
    "vendor-mermaid": "node scripts/vendor-mermaid.mjs",
    "check": "node scripts/check-site.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "translate": "node scripts/translate.mjs",
    "translate:force": "node scripts/translate.mjs --force",
    "fetch-telegram-reactions": "node themes/hugo-mini/scripts/fetch-telegram-reactions.mjs",
    "fetch-github-stars": "node themes/hugo-mini/scripts/fetch-github-stars.mjs zavarovkv/hugo-mini",
    "event:new": "node events/scripts/new.mjs"
  },
  "devDependencies": {
    "mermaid": "11.16.1",
    "openai": "7.4.0",
    "parse5": "8.0.1",
    "smol-toml": "1.9.0"
  }
}
